    'deathmatch': 'Deathmatch', 'scrimcomp2v2': 'Wingman', 'gungameprogressive': 'Arms Race',
    'gungametrbomb': 'Demolition', 'training': 'Training', 'survival': 'Danger Zone',
    'cooperative': 'Guardian', 'coopmission': 'Co-op Strike', 'skirmish': 'War Games',
    'custom': 'Custom',
}
MAX_ROUNDS = {'competitive': 24, 'premier': 24, 'scrimcomp2v2': 16}
SCORELESS = {'deathmatch', 'gungameprogressive', 'training', 'custom'}
MAP_NAMES = {
    'de_dust2': 'Dust II', 'cs_italy': 'Italy', 'cs_office': 'Office', 'cs_agency': 'Agency',
    'ar_pool_day': 'Pool Day', 'de_ancient_night': 'Ancient Night',
}
# Maps with a picture at MAP_IMAGES; any other map shows the CS2 icon.
MAP_PICTURES = set('''ar_baggage ar_pool_day ar_shoots cs_agency cs_alpine cs_italy cs_office de_ancient
de_anubis de_basalt de_brewery de_cache de_dogtown de_dust2 de_edin de_golden de_grail de_inferno
de_jura de_mills de_mirage de_nuke de_overpass de_palacio de_poseidon de_rooftop de_sanctum
de_stronghold de_thera de_train de_vertigo fy_pool_day'''.split())
TEAMS = {'CT': 'Counter-Terrorist', 'T': 'Terrorist'}

running = True
gsi_lock = threading.Lock()
gsi = {'data': None, 'at': 0.0}


# ---- Game detection and Game State Integration -------------------------------------------------

def find_game():
    """Return (pid, start time) of the user's running cs2, or None."""
    for proc in Path('/proc').iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid() or proc.joinpath('comm').read_text().strip() != 'cs2':
                continue
            if proc.joinpath('exe').resolve().name != 'cs2':
                continue
            ticks = int(proc.joinpath('stat').read_text().rsplit(')', 1)[1].split()[19])
            uptime = float(Path('/proc/uptime').read_text().split()[0])
            return int(proc.name), int(time.time() - uptime + ticks / os.sysconf('SC_CLK_TCK'))
        except (OSError, ValueError, IndexError):
            continue
    return None


def cfg_dirs():
    """CS2's cfg folder in every Steam library (native, Flatpak and Snap Steam)."""
    home = Path.home()
    roots = [home / '.local/share/Steam', home / '.steam/steam', home / '.steam/root',
             home / '.var/app/com.valvesoftware.Steam/.local/share/Steam',
             home / 'snap/steam/common/.local/share/Steam']
    libraries = set()
    for root in roots:
        try:
            vdf = (root / 'steamapps/libraryfolders.vdf').read_text(errors='replace')
        except OSError:
            continue
        libraries.add(root.resolve())
        libraries.update(Path(p.replace('\\\\', '\\')).resolve()
                         for p in re.findall(r'"path"\s+"([^"]+)"', vdf))
    found = set()
    for library in libraries:
        cfg = library / 'steamapps/common/Counter-Strike Global Offensive/game/csgo/cfg'
        if cfg.is_dir():
            found.add(cfg.resolve())
    return sorted(found)


def install_cfg():
    """Put the Game State Integration config in place; CS2 reads it when it starts."""
    for folder in cfg_dirs():
        target = folder / CFG_NAME
        try:
            if not target.exists() or target.read_text() != CFG:
                target.write_text(CFG)
                print(f'Installed Game State Integration config in {folder}', flush=True)
        except OSError as error:
            print(f'Could not write {target}: {error}', flush=True)


class GSIHandler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        try:
            size = int(self.headers.get('Content-Length', 0))
            data = json.loads(self.rfile.read(min(size, 1024 * 1024)))
            ok = isinstance(data, dict) and data.get('auth', {}).get('token') == TOKEN
        except (ValueError, AttributeError):
            ok = False
        if ok:
            with gsi_lock:
                if gsi['data'] is None:
                    print('Receiving game state from CS2', flush=True)
                gsi['data'], gsi['at'] = data, time.monotonic()
        self.send_response(200 if ok else 403)
        self.send_header('Content-Length', '0')
        self.end_headers()

    def log_message(self, *_args):
        pass


def start_gsi_server():
    try:
        server = http.server.ThreadingHTTPServer(('127.0.0.1', PORT), GSIHandler)
    except OSError as error:
        print(f'Game State Integration off, port {PORT} unavailable: {error}', flush=True)
        return
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()


# ---- Building the activity ---------------------------------------------------------------------

def map_title(name):
    base = name.rsplit('/', 1)[-1].lower()
    if base in MAP_NAMES:
        return MAP_NAMES[base]
    words = re.sub(r'^(de|cs|ar|dz|gd|aim|awp|fy|surf|bhop|kz|ze|zm|workshop)_', '', base).split('_')
    return ' '.join(w if w.isdigit() else w.capitalize() for w in words if w) or name


def text(value, limit=128):
    """Discord wants 2-128 characters per field."""
    value = ' '.join(str(value).split())
    if len(value) > limit:
        value = value[:limit - 1].rstrip() + '…'
    return value if len(value) >= 2 else None


class Tracker:
    """Remembers what the game no longer reports: your own stats while you spectate after dying, and
    when the current map started."""

    def __init__(self):
        self.reset()

    def reset(self):
        self.map_key = None
        self.map_started = None
        self.team = None
        self.stats = {}

    def update(self, data):
        me = data.get('provider', {}).get('steamid')
        game_map = data.get('map') or {}
        key = (game_map.get('name'), game_map.get('mode')) if game_map else None
        if key != self.map_key:
            self.map_key = key
            self.map_started = int(time.time()) if key else None
            self.team = None
            self.stats = {}
        player = data.get('player') or {}
        if me and player.get('steamid') == me:
            self.team = player.get('team') or self.team
            self.stats = player.get('match_stats') or self.stats


def build_activity(game, data, tracker):
    _pid, launched = game
    activity = {'type': 0, 'timestamps': {'start': launched}}
    if not data:
        return activity
    tracker.update(data)
    me = data.get('provider', {}).get('steamid')
    player = data.get('player') or {}
    own = bool(me) and player.get('steamid') == me
    game_map = data.get('map') or {}
    if me:
        activity['buttons'] = [{'label': 'Steam profile', 'url': f'https://steamcommunity.com/profiles/{me}'}]

    if not game_map:
        menu = {'menu': 'In the main menu', 'textinput': 'In the main menu (typing)'}
        activity['details'] = menu.get(player.get('activity'), 'In the main menu')
        if player.get('name'):
            activity['state'] = text(f"as {player['name']}")
        return activity

    mode_key = game_map.get('mode', '')
    mode = MODES.get(mode_key, mode_key.replace('_', ' ').title() or 'Match')
    raw_map = game_map.get('name', '')
    title = map_title(raw_map)
    phase = game_map.get('phase')
    rnd = data.get('round') or {}
    ct = int((game_map.get('team_ct') or {}).get('score', 0))
    t = int((game_map.get('team_t') or {}).get('score', 0))
    team = tracker.team
    stats = tracker.stats
    if tracker.map_started:
        activity['timestamps'] = {'start': tracker.map_started}

    # details: mode, map and score from your side.
    score = ''
    if mode_key not in SCORELESS:
        if team in ('CT', 'T'):
            us, them = (ct, t) if team == 'CT' else (t, ct)
            score = f' · {us}–{them}'
        else:
            score = f' · CT {ct}–{t} T'
    activity['details'] = text(f'{mode} · {title}{score}')

    # state: match phase and your scoreboard line.
    k, a, d = (int(stats.get(x, 0)) for x in ('kills', 'assists', 'deaths'))
    mvps, points = int(stats.get('mvps', 0)), int(stats.get('score', 0))
    if mode_key in ('deathmatch', 'gungameprogressive'):
        line = f'{k} kills · {d} deaths · {points} pts'
    elif stats:
        line = f'{k} / {a} / {d} K/A/D' + (f' · {mvps} MVP' + ('s' if mvps != 1 else '') if mvps else '')
    else:
        line = ''
    rounds_done = int(game_map.get('round', 0))
    round_now = rounds_done + (0 if phase == 'gameover' or rnd.get('phase') == 'over' else 1)
    if phase == 'warmup':
        prefix = 'Warmup'
    elif phase == 'intermission':
        prefix = 'Halftime'
    elif phase == 'gameover':
        if team in ('CT', 'T') and mode_key not in SCORELESS:
            us, them = (ct, t) if team == 'CT' else (t, ct)
            prefix = 'Won' if us > them else 'Lost' if us < them else 'Draw'
        else:
            prefix = 'Match over'
    elif mode_key in SCORELESS:
        prefix = ''
    elif round_now > MAX_ROUNDS.get(mode_key, 10 ** 6):
        prefix = f'Overtime, round {round_now}'
    elif mode_key not in MAX_ROUNDS:
        prefix = f'Round {round_now}'
    else:
        prefix = ''
    activity['state'] = text(' · '.join(x for x in (prefix, line) if x)) or text(mode)

    # Round progress as the party size ("13 of 24") in modes with a fixed length.
    max_rounds = MAX_ROUNDS.get(mode_key)
    if max_rounds and phase == 'live' and 1 <= round_now <= max_rounds:
        activity['party'] = {'id': f"cs2-{me or 'local'}-{raw_map}", 'size': [round_now, max_rounds]}

    # Images: map picture (or the CS2 icon) and your team badge.
    base = raw_map.rsplit('/', 1)[-1].lower()
    hover = [f'{title} ({base})' if base and title.lower() != base else title]
    if phase in ('live', 'intermission') and mode_key not in SCORELESS:
        hover.append(f'Round {round_now}')
    bomb = {'planted': 'Bomb planted', 'defused': 'Bomb defused', 'exploded': 'Bomb exploded'}
    if rnd.get('bomb') in bomb:
        hover.append(bomb[rnd['bomb']])
    elif rnd.get('phase') == 'freezetime':
        hover.append('Freeze time')
    assets = {}
    if base in MAP_PICTURES:
        assets['large_image'] = f'{MAP_IMAGES}/{base}.png'
        assets['large_text'] = text(' · '.join(hover))
    if team in ('CT', 'T') and 'large_image' in assets:
        assets['small_image'] = f'{ASSETS}/{team.lower()}.png?v=1'
        state = player.get('state') or {}
        if own and int(state.get('health', 0)) > 0:
            bits = [TEAMS[team], f"{state.get('health', 0)} HP"]
            if int(state.get('armor', 0)):
                bits.append(f"{state['armor']} armour" + (' + helmet' if state.get('helmet') else ''))
            if 'money' in state:
                bits.append(f"${int(state['money']):,}")
            assets['small_text'] = text(' · '.join(bits))
        elif phase == 'live' and player.get('name') and not own:
            assets['small_text'] = text(f"{TEAMS[team]} · dead, watching {player['name']}")
        else:
            assets['small_text'] = TEAMS[team]
    if assets:
        activity['assets'] = {k: v for k, v in assets.items() if v}
    return activity


# ---- Discord RPC -------------------------------------------------------------------------------

def send_frame(sock, opcode, data):
    payload = json.dumps(data, separators=(',', ':')).encode()
    sock.sendall(struct.pack('<II', opcode, len(payload)) + payload)


def receive_exact(sock, size):
    result = bytearray()
    while len(result) < size:
        chunk = sock.recv(size - len(result))
        if not chunk:
            raise ConnectionError('RPC socket closed')
        result.extend(chunk)
    return bytes(result)


def receive_frame(sock):
    while True:
        opcode, size = struct.unpack('<II', receive_exact(sock, 8))
        if size > 1024 * 1024:
            raise ValueError('RPC frame too large')
        data = json.loads(receive_exact(sock, size))
        if opcode == 3:
            send_frame(sock, 4, data)
        elif opcode == 2:
            raise ConnectionError(f'RPC closed: {data}')
        else:
            return data


def connect():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    # Native Discord (and Vesktop/arRPC), then the Flatpak and Snap sandboxes' sockets.
    sockets = [*sorted(runtime.glob('discord-ipc-*')), *sorted(runtime.glob('app/*/discord-ipc-*')),
               *sorted(runtime.glob('snap.discord*/discord-ipc-*'))]
    for path in sockets:
        sock = socket.socket(socket.AF_UNIX)
        sock.settimeout(3)
        try:
            sock.connect(str(path))
            send_frame(sock, 0, {'v': 1, 'client_id': CLIENT_ID})
            if receive_frame(sock).get('evt') != 'READY':
                raise ConnectionError('RPC was not ready')
            return sock
        except (OSError, ValueError, ConnectionError):
            sock.close()
    raise ConnectionError('Discord RPC unavailable')


def set_activity(sock, pid, activity):
    nonce = str(uuid.uuid4())
    send_frame(sock, 1, {'cmd': 'SET_ACTIVITY', 'nonce': nonce, 'args': {'pid': pid, 'activity': activity}})
    while True:
        reply = receive_frame(sock)
        if reply.get('nonce') == nonce:
            if reply.get('evt') == 'ERROR':
                raise ValueError(f"Discord rejected the activity: {reply.get('data')}")
            return


def stop(_signum, _frame):
    global running
    running = False


def main():
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    install_cfg()
    start_gsi_server()
    tracker = Tracker()
    sock = game = None
    sent = None        # (pid, activity) last accepted by Discord
    sent_at = 0.0
    next_scan = next_cfg = 0.0
    last_error = None
    try:
        while running:
            now = time.monotonic()
            if now >= next_scan:
                game = find_game()
                next_scan = now + 5
            if not game and now >= next_cfg:
                install_cfg()  # Steam may have been (re)installed or a library added.
                next_cfg = now + 300
            try:
                if game:
                    with gsi_lock:
                        data = gsi['data'] if now - gsi['at'] < GSI_STALE_AFTER else None
                    activity = build_activity(game, data, tracker)
                    changed = sent != (game[0], activity)
                    if (changed and now - sent_at >= MIN_SEND_INTERVAL) or now - sent_at >= RESEND_INTERVAL:
                        if sock is None:
                            sock = connect()
                        set_activity(sock, game[0], activity)
                        if sent is None or sent[0] != game[0]:
                            print('CS2 activity started', flush=True)
                        if changed:
                            print('Activity:', activity.get('details', '-'), '|', activity.get('state', '-'), flush=True)
                        sent, sent_at, last_error = (game[0], activity), now, None
                elif sock or sent:
                    with gsi_lock:
                        gsi['data'] = None
                    tracker.reset()
                    if sock and sent:
                        set_activity(sock, sent[0], None)
                        print('CS2 activity cleared', flush=True)
                    if sock:
                        sock.close()
                    sock = sent = None
            except (OSError, ValueError, ConnectionError) as error:
                if str(error) != last_error:
                    print(f'Discord: {error}', flush=True)
                    last_error = str(error)
                if sock:
                    sock.close()
                sock, sent, sent_at = None, None, now
            time.sleep(1)
    finally:
        if sock:
            try:
                if sent:
                    set_activity(sock, sent[0], None)
            except (OSError, ValueError, ConnectionError):
                pass
            sock.close()


if __name__ == '__main__':
    main()
