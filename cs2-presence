#!/usr/bin/env python3
"""cs2-presence: native Linux Counter-Strike 2 as Discord Rich Presence.

Discord doesn't detect CS2's native Linux build. This finds the running `cs2` process and publishes
an activity through the Discord client's local RPC socket. With CS2's Game State Integration (a
config file this script installs in the game's cfg folder) the activity also shows the mode, map,
score, round, your team, K/A/D, MVPs, health, armour and money. Standard library only; runs as a
systemd user service.
"""
import http.server
import json
import os
from pathlib import Path
import re
import signal
import socket
import struct
import threading
import time
import uuid

CLIENT_ID = '1158877933042143272'  # Discord's own Counter-Strike 2 application.
PORT = int(os.environ.get('CS2_PRESENCE_PORT', '3713'))
TOKEN = 'cs2-presence'
